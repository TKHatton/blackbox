# Copy to .env and fill in. .env is gitignored and must never be committed.

# ---- Google Cloud ----
# The dedicated project for BLACKBOX. Keep it separate from other projects.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# The Firestore database id. BLACKBOX uses a named database, not "(default)".
# Every client must pass this, or it silently reads and writes the wrong database.
FIRESTORE_DATABASE=blackbox-database

# ---- Gemini on Vertex AI ----
# All model inference goes through Gemini. No other provider appears anywhere.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GEMINI_MODEL=gemini-3.5-flash

# ---- Pub/Sub ----
# The topic complaints arrive on. A message here is what causes an agent to run.
COMPLAINTS_TOPIC=blackbox-complaints

# ---- Region pinning ----
# Which region this instance runs in. Checked on every Wiki read, so it must
# match where the service is actually deployed.
WORKER_REGION=EU

# ---- Tracing ----
# cloud_trace on Cloud Run, console locally, none in tests.
TRACE_EXPORTER=console

# ---- Local development only ----
# Set to 1 to use the in-memory store instead of Firestore. Never set on Cloud Run.
BLACKBOX_IN_MEMORY=
